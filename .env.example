# Скопируйте в .env и заполните. Файл .env в git НЕ коммитим.

# База — SQLite-файл, его строит скрипт etl/. В Docker путь задаёт docker-compose.yml.
DATABASE_URL=sqlite:///data/ilfa.db

# Адрес API для интерфейса
API_URL=http://localhost:8000

# Ключ нейросети для offers/ (YandexGPT / GigaChat)
LLM_API_KEY=
